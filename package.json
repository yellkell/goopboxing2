{
  "name": "goopboxing2",
  "version": "0.1.0",
  "description": "SLUGFEST \u2014 a two-player WebXR boxing game where both fighters ARE the goop. Embody a man-sized gel creature, throw real punches with your real hands, and cave in your opponent's raymarched body. Built on the Immersive Web SDK; multiplayer over Firebase.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "emu": "node tools/emulators.mjs",
    "probe": "node tools/embody-check.mjs && node tools/fight-probe.mjs",
    "probe:online": "node tools/online-probe.mjs"
  },
  "dependencies": {
    "@iwsdk/core": "0.4.2",
    "firebase": "^12.17.1",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@iwsdk/vite-plugin-dev": "0.4.2",
    "@types/three": "0.184.0",
    "firebase-tools": "^15.28.1",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
